              },\\\\n                    \\\\\\\"conflict_point\\\\\\\": {\\\\n                      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\"\\\\n                    },\\\\n                    \\\\\\\"emotional_shift\\\\\\\": {\\\\n                      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\"\\\\n                    },\\\\n                    \\\\\\\"scene_outcome\\\\\\\": {\\\\n                      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\"\\\\n                    }\\\\n                  }\\\\n                }\\\\n              },\\\\n              \\\\\\\"emotional_tone\\\\\\\": {\\\\n                \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n                \\\\\\\"description\\\\\\\": \\\\\\\"本章整体情感基调\\\\\\\"\\\\n              }\\\\n            }\\\\n          }\\\\n        },\\\\n        \\\\\\\"turning_point\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"本幕结尾的转折点（可选，第三幕往往是渐进而非突变）\\\\\\\"\\\\n        }\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\\n\\\",\\n  \\\"size\\\": 10380\\n}\"}], \"isError\": false}"
