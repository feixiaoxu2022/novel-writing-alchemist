          "functionCall": {
            "name": "novel_writing_service__write_file",
            "args": {
              "content": "{\n  \"act_one\": {\n    \"description\": \"婚礼前夜，刑警沈翊发现深爱的未婚妻陆晚竟是系统预警的凶手。他在震惊与怀疑中展开调查，发现温馨的婚房实则是精心布置的处决场。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 1,\n        \"chapter_title\": \"倒计时：12小时\",\n        \"core_event\": \"沈翊在试穿礼服时，系统首次激活，显示陆晚额头的死亡倒计时。\",\n        \"emotional_tone\": \"震惊、疑惑、不安\",\n        \"key_scenes\": [\"婚纱店试衣间\", \"系统界面首次显现\"]\n      },\n      {\n        \"chapter_number\": 3,\n        \"chapter_title\": \"枕边凶机\",\n        \"core_event\": \"深夜，沈翊假睡，目睹陆晚在厨房处理疑似凶器，系统提示危险飙升。\",\n        \"emotional_tone\": \"惊悚、压抑\",\n        \"key_scenes\": [\"深夜卧室\", \"厨房磨刀声\"]\n      },\n      {\n        \"chapter_number\": 5,\n        \"chapter_title\": \"婚房即牢笼\",\n        \"core_event\": \"沈翊回家发现新房装修暗藏监控与机关，意识到这是一场蓄谋已久的谋杀。\",\n        \"emotional_tone\": \"绝望、背叛感\",\n        \"key_scenes\": [\"新房客厅\", \"隐藏摄像头视角\"]\n      },\n      {\n        \"chapter_number\": 9,\n        \"chapter_title\": \"最后的晚餐\",\n        \"core_event\": \"陆晚准备了烛光晚餐，沈翊明知酒中有毒依然饮下，赌她不忍心。\",\n        \"emotional_tone\": \"悲壮、试探\",\n        \"key_scenes\": [\"餐桌对峙\", \"毒酒入喉\"]\n      }\n    ],\n    \"turning_point\": \"沈翊未死但身体麻痹，直接摊牌质问。陆晚流泪承认杀意，但拒绝解释原因，只说“为了你好”。\"\n  },\n  \"act_two\": {\n    \"description\": \"沈翊试图逃脱并查清真相，两人展开高智商攻防。随着调查深入，沈翊发现陆晚背负的惊天秘密，杀意背后是救世的无奈。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 12,\n        \"chapter_title\": \"反客为主\",\n        \"core_event\": \"沈翊利用刑警技能解开束缚，反向控制住陆晚，试图逼问真相。\",\n        \"emotional_tone\": \"紧张、激烈对抗\",\n        \"key_scenes\": [\"卧室格斗\", \"手铐互换\"]\n      },\n      {\n        \"chapter_number\": 20,\n        \"chapter_title\": \"第三个名字\",\n        \"core_event\": \"沈翊查到陆晚销毁的档案中提到代号“潘多拉”的证人，系统警告“接触即死”。\",\n        \"emotional_tone\": \"悬疑、紧迫\",\n        \"key_scenes\": [\"档案室\", \"加密文件破解\"]\n      },\n      {\n        \"chapter_number\": 28,\n        \"chapter_title\": \"无解的死结\",\n        \"core_event\": \"真相大白：“潘多拉”携带灭世病毒，只有沈翊的生物体征能开启隔离舱。他活着，就是世界的威胁。\",\n        \"emotional_tone\": \"绝望、宿命感\",\n        \"key_scenes\": [\"废弃实验室\", \"病毒模拟推演\"]\n      }\n    ],\n    \"turning_point\": \"沈翊意识到系统预警的正确性：为了世界，他必须死。但他不愿让陆晚背负杀人罪名。\"\n  },\n  \"act_three\": {\n    \"description\": \"时间归零。沈翊决定以自己的方式终结这一切，用生命完成最后的婚礼，成全陆晚的大义与爱。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 35,\n        \"chapter_title\": \"婚礼变奏曲\",\n        \"core_event\": \"老张带队包围婚房，沈翊挟持陆晚（实则保护她），要求所有人退后。\",\n        \"emotional_tone\": \"悲壮、混乱\",\n        \"key_scenes\": [\"被包围的婚房\", \"对峙喊话\"]\n      },\n      {\n        \"chapter_number\": 38,\n        \"chapter_title\": \"借刀杀人\",\n        \"core_event\": \"沈翊故意激怒陆晚，制造她正当防卫的假象，主动撞向她的刀口。\",\n        \"emotional_tone\": \"极致虐心、高潮\",\n        \"key_scenes\": [\"慢动作撞击\", \"眼神交流\"]\n      },\n      {\n        \"chapter_number\": 40,\n        \"chapter_title\": \"未亡人的誓言\",\n        \"core_event\": \"陆晚独自完成婚礼仪式，随后自首。世界安然无恙，唯独她失去了光。\",\n        \"emotional_tone\": \"凄美、余韵悠长\",\n        \"key_scenes\": [\"单人婚礼\", \"墓碑前的戒指\"]\n      }\n    ]\n  }\n}",
              "path": "outline.json"
