                "content": "{\n  \"act_one\": {\n    \"description\": \"重生与误会建立：陆以宁重生归来，面对'复仇者'江野，开启了'她杀我宠'的爆笑日常。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 1,\n        \"chapter_title\": \"重回十六岁与'谋杀'现场\",\n        \"core_event\": \"陆以宁重生回训练馆，激动拥抱江野，江野僵硬并试图推开（其实是想推倒她）。\",\n        \"emotional_tone\": \"惊喜/错位幽默\",\n        \"key_scenes\": [\"重生醒来\", \"更衣室的'偷袭'（江野想锁门困住陆，陆以为江野想独处）\"]\n      },\n      {\n        \"chapter_number\": 5,\n        \"chapter_title\": \"加料的运动饮料\",\n        \"core_event\": \"江野在水中放了泻药想让陆出丑，系统提示'队友赠送爱心特饮'，陆感动喝下（系统净化了毒素）。\",\n        \"emotional_tone\": \"甜爽/滑稽\",\n        \"key_scenes\": [\"江野期待的眼神\", \"陆以宁豪爽畅饮\", \"江野怀疑人生的表情\"]\n      },\n      {\n        \"chapter_number\": 10,\n        \"chapter_title\": \"选拔赛的'配合'\",\n        \"core_event\": \"省队选拔赛，江野故意不配合交接棒（团体项目），陆以宁预判并完美化解，在外人看来是神级默契。\",\n        \"emotional_tone\": \"热血/打脸\",\n        \"key_scenes\": [\"赛场惊险一刻\", \"赛后采访陆以宁夸赞江野'有想法'\"]\n      }\n    ],\n    \"turning_point\": \"陆以宁强行申请与江野同宿舍，江野的'暗杀'计划被迫转为'同居'生活，关系被迫拉近。\"\n  },\n  \"act_two\": {\n    \"description\": \"磨合与动摇：封闭训练期间，江野的防线在陆以宁无微不至的关怀（和强大的实力）下逐渐崩塌。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 20,\n        \"chapter_title\": \"噩梦与温热的怀抱\",\n        \"core_event\": \"江野做噩梦（前世瘫痪），陆以宁整夜安抚。江野醒来发现自己在'仇人'怀里，心态复杂。\",\n        \"emotional_tone\": \"温馨/微虐\",\n        \"key_scenes\": [\"深夜宿舍\", \"陆以宁哼唱的摇篮曲\"]\n      },\n      {\n        \"chapter_number\": 30,\n        \"chapter_title\": \"中点转折：意外重演\",\n        \"core_event\": \"训练器械真的出现故障（非江野所为），陆以宁下意识护住江野受伤。江野崩溃，确信这一世的陆以宁不同。\",\n        \"emotional_tone\": \"紧张/情感爆发\",\n        \"key_scenes\": [\"器械断裂瞬间\", \"医务室的对峙\"]\n      },\n      {\n        \"chapter_number\": 35,\n        \"chapter_title\": \"双人核心技能解锁\",\n        \"core_event\": \"两人终于心意相通（江野单方面放下仇恨），练成了高难度的双人配合动作。\",\n        \"emotional_tone\": \"爽感/默契\",\n        \"key_scenes\": [\"训练馆深夜的完美落地\"]\n      }\n    ],\n    \"turning_point\": \"奥运大名单公布，两人入选，但面临外界质疑和针对。\"\n  },\n  \"act_three\": {\n    \"description\": \"决战与真相：奥运赛场，前世的阴影逼近，两人携手打破宿命，真相大白。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 45,\n        \"chapter_title\": \"平衡木上的博弈\",\n        \"core_event\": \"决赛前夕，前世导致事故的真凶（嫉妒的替补队员或维护人员）浮出水面。江野想独自解决，被陆以宁按住。\",\n        \"emotional_tone\": \"紧张/悬疑揭秘\",\n        \"key_scenes\": [\"器材室的抓包\", \"陆以宁霸气护妻\"]\n      },\n      {\n        \"chapter_number\": 48,\n        \"chapter_title\": \"宿命的一跳\",\n        \"core_event\": \"奥运决赛，到了前世出事的同一个动作。两人眼神交汇，完美完成，打破诅咒。\",\n        \"emotional_tone\": \"高燃/感动\",\n        \"key_scenes\": [\"慢动作特写\", \"落地后的拥抱\"]\n      },\n      {\n        \"chapter_number\": 50,\n        \"chapter_title\": \"金牌与告白\",\n        \"core_event\": \"领奖台上，江野坦白自己重生和曾经的杀意。陆以宁笑着说'早知道了，小傻瓜'。\",\n        \"emotional_tone\": \"圆满/甜蜜\",\n        \"key_scenes\": [\"升国旗\", \"赛后采访的'官宣'（暗示）\"]\n      }\n    ]\n  }\n}\n",
