                  "content": "{\n  \"main_characters\": [\n    {\n      \"name\": \"陆以宁\",\n      \"role\": \"protagonist\",\n      \"identity\": \"前金牌教练 / 现役天才体操运动员\",\n      \"traits\": [\"情绪稳定\", \"护短狂魔\", \"恋爱脑补帝\", \"技术流\"],\n      \"overt_motivation\": \"带领江野拿下奥运金牌，改变她瘫痪的命运\",\n      \"covert_motivation\": \"弥补前世的愧疚，重新获得江野的信任\",\n      \"secret_fear\": \"再次看到江野倒在自己面前\",\n      \"misperception_of_other\": \"认为江野的各种针对行为是'青春期叛逆'和'别扭的关心'（自带十级滤镜）\",\n      \"hidden_connection\": \"前世江野是为了救陆以宁才受伤，陆以宁并不知情（直到重生后逐渐揭开）\"\n    },\n    {\n      \"name\": \"江野\",\n      \"role\": \"deuteragonist\",\n      \"identity\": \"重生复仇者 / 潜力体操新星\",\n      \"traits\": [\"炸毛小狼狗\", \"PTSD患者\", \"口嫌体正直\", \"傲娇\"],\n      \"overt_motivation\": \"报复陆以宁，或者至少远离她保命\",\n      \"covert_motivation\": \"内心深处依然渴望陆以宁的认可与保护，但不敢相信\",\n      \"secret_fear\": \"重蹈覆辙，再次被最信任的人背叛\",\n      \"misperception_of_other\": \"认为陆以宁的示好是'笑面虎'的伪装，是更深层的捧杀\",\n      \"hidden_connection\": \"两世都深爱着陆以宁，第一世是牺牲，第二世是因爱生恨\"\n    }\n  ],\n  \"supporting_characters\": [\n    {\n      \"name\": \"系统（完美搭档版）\",\n      \"function\": \"助力\",\n      \"identity\": \"高维辅助工具\",\n      \"description\": \"辅助陆以宁训练的系统，具有'好感度误读'功能，常将江野的'杀意值'误报为'羁绊值'，助攻陆以宁的脑补。\"\n    },\n    {\n      \"name\": \"周教练\",\n      \"function\": \"阻碍\",\n      \"identity\": \"国家队总教练\",\n      \"description\": \"唯成绩论的严苛教练，前期试图拆散两人的搭档组合。\"\n    }\n  ],\n  \"relationship_dynamics\": \"猫鼠游戏的喜剧变体。江野（鼠）拼命设陷阱想反杀或逃跑，陆以宁（猫）以为是在玩游戏，一脸宠溺地把陷阱踩平，还反手给鼠顺毛。随着剧情推进，江野的'杀意'逐渐被陆以宁的'宠溺'消解，变成真正的'傲娇'。\"\n}",
                  "path": "characters.json"
                },
