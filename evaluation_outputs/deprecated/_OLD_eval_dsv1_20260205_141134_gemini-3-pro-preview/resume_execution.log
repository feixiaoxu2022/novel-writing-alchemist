              "files": [
                {
                  "content": "{\n  \"main_characters\": [\n    {\n      \"name\": \"林听\",\n      \"role\": \"protagonist\",\n      \"identity\": \"盲人配音演员 / 末世幸存者\",\n      \"traits\": [\"听觉超凡\", \"坚韧\", \"依赖'系统'\", \"深情\"],\n      \"overt_motivation\": \"跟随'系统'的指引，在丧尸包围的录音棚中活下去\",\n      \"covert_motivation\": \"寻找失踪的恋人陈默，坚信他还活着\",\n      \"secret_fear\": \"彻底的寂静（意味着'系统'消失或被世界遗弃）\",\n      \"misperception_of_other\": \"认为耳机里的滴答声是高科技生存系统的提示音，不知道那是陈默的摩斯密码\",\n      \"hidden_connection\": \"她依赖的'系统'实际上是陈默的生命倒计时\"\n    },\n    {\n      \"name\": \"陈默\",\n      \"role\": \"deuteragonist\",\n      \"identity\": \"失语狙击手 / 重生者\",\n      \"traits\": [\"失语\", \"深情隐忍\", \"战术大师\", \"自我牺牲\"],\n      \"overt_motivation\": \"利用前世记忆和狙击技能，暗中保护林听\",\n      \"covert_motivation\": \"弥补前世没能救下她的遗憾，哪怕代价是再次牺牲自己\",\n      \"secret_fear\": \"林听发现真相后会为了救他而放弃生路\",\n      \"misperception_of_other\": \"认为林听如果知道真相会崩溃，所以选择隐瞒身份\",\n      \"hidden_connection\": \"前世是恋人，今生化作她的'眼睛'和'系统'\"\n    }\n  ],\n  \"supporting_characters\": [\n    {\n      \"name\": \"丧尸群（听觉变异种）\",\n      \"function\": \"阻碍\",\n      \"identity\": \"末世怪物\",\n      \"description\": \"对声音极度敏感的丧尸，迫使两人必须保持绝对安静，强化了'录音棚'的环境张力\"\n    }\n  ],\n  \"relationship_dynamics\": \"双向暗恋+认知错位。林听爱着陈默却依赖着'系统'，陈默爱着林听却只能做'系统'。这种错位在末世的极限生存压力下被无限放大，直到最后真相大白时的情感决堤。\"\n}",
                  "path": "characters.json"
                },
                {
                  "content": "{\n  \"act_one\": {\n    \"description\": \"建立录音棚的封闭环境，确立'盲女+系统'的生存模式，暗示'系统'的真实身份。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 1,\n        \"chapter_title\": \"黑暗中的滴答声\",\n        \"core_event\": \"盲女林听在录音棚醒来，依靠耳机里的'系统提示音'（摩斯密码）躲过第一波丧尸。\",\n        \"emotional_tone\": \"悬疑、压抑、依赖\",\n        \"key_scenes\": [\"林听在黑暗中摸索\", \"耳机里传来急促的滴答声\", \"丧尸贴着玻璃擦过\"]\n      },\n      {\n        \"chapter_number\": 2,\n        \"chapter_title\": \"无声的守护者\",\n        \"core_event\": \"切换陈默视角（或侧面描写），揭示他在通风管道/暗处的艰难狙击，以及喉咙无法发声的痛苦。\",\n        \"emotional_tone\": \"隐忍、紧张\",\n        \"key_scenes\": [\"陈默架枪的手在颤抖\", \"看着林听险些受伤时的无声嘶吼\", \"回忆前世喉咙破裂的瞬间\"]\n      },\n      {\n        \"chapter_number\": 3,\n        \"chapter_title\": \"人声诱饵\",\n        \"core_event\": \"为了引开聚集的丧尸，'系统'发布任务：利用录音棚设备播放人声。林听操作，陈默暗中接线。\",\n        \"emotional_tone\": \"紧张、默契\",\n        \"key_scenes\": [\"林听录制诱饵声音\", \"陈默在黑暗中接驳断裂的线路\", \"两人隔着玻璃的'对视'\"]\n      }\n    ],\n    \"turning_point\": \"设备故障，陈默不得不冒险进入录音室修复，两人近在咫尺，林听闻到了熟悉的烟草味（陈默身上的味道），产生怀疑。\"\n  },\n  \"act_two\": {\n    \"description\": \"生存危机升级，从录音棚扩展到大楼内部。规则怪谈式的生存挑战，情感在生死边缘升温。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 4,\n        \"chapter_title\": \"规则：绝对安静\",\n        \"core_event\": \"大楼内出现听觉变异丧尸。'系统'发布规则：禁止说话，禁止脚步声。\",\n        \"emotional_tone\": \"惊悚、压抑\",\n        \"key_scenes\": [\"林听赤脚走在碎玻璃旁\", \"陈默用身体接住掉落的物品\", \"耳机里传来'系统'急促的心跳般节奏\"]\n      },\n      {\n        \"chapter_number\": 5,\n        \"chapter_title\": \"不存在的队友\",\n        \"core_event\": \"林听在探索中遭遇险情，被'神秘人'（陈默）拉了一把。她开始怀疑'系统'有实体。\",\n        \"emotional_tone\": \"疑惑、希冀\",\n        \"key_scenes\": [\"黑暗中温暖的手掌\", \"林听试图抓住对方却抓空\", \"陈默躲在阴影里喘息\"]\n      },\n      {\n        \"chapter_number\": 6,\n        \"chapter_title\": \"隔空的告白\",\n        \"core_event\": \"林听以为自己必死，对着空气向'系统'倾诉对陈默的思念。陈默在耳机另一端听得泪流满面。\",\n        \"emotional_tone\": \"虐心、深情\",\n        \"key_scenes\": [\"林听的独白\", \"陈默无声的哭泣\", \"摩斯密码敲出'活下去'\"]\n      },\n      {\n        \"chapter_number\": 7,\n        \"chapter_title\": \"尸潮围城\",\n        \"core_event\": \"丧尸大军包围大楼，录音棚成为最后的孤岛。资源耗尽。\",\n        \"emotional_tone\": \"绝望、紧迫\",\n        \"key_scenes\": [\"窗外密密麻麻的尸群\", \"最后的食物分发（陈默把自己的给了林听）\"]\n      }\n    ],\n    \"turning_point\": \"大门即将被攻破，陈默意识到必须执行前世未完成的计划——D21牺牲方案。他开始准备最后的录音。\"\n  },\n  \"act_three\": {\n    \"description\": \"真相大白，最后的牺牲与告白。情感彻底爆发。\",\n    \"key_chapters\": [\n      {\n        \"chapter_number\": 8,\n        \"chapter_title\": \"最后的任务\",\n        \"core_event\": \"'系统'发布最终任务：进入安全屋并锁门。林听抗拒，感觉到不对劲。\",\n        \"emotional_tone\": \"焦急、冲突\",\n        \"key_scenes\": [\"林听拒绝执行指令\", \"耳机里传来极其复杂的摩斯密码（不再是指令，而是名字）\"]\n      },\n      {\n        \"chapter_number\": 9,\n        \"chapter_title\": \"触碰真相\",\n        \"core_event\": \"丧尸冲入。陈默现身保护林听。林听摸到了他的脸和失声的喉咙，瞬间明白一切。\",\n        \"emotional_tone\": \"震撼、崩溃\",\n        \"key_scenes\": [\"指尖触碰到的疤痕\", \"林听的尖叫\", \"陈默强行将她推入安全屋\"]\n      },\n      {\n        \"chapter_number\": 10,\n        \"chapter_title\": \"盛大的诱饵\",\n        \"core_event\": \"陈默打开所有扩音设备，冲向尸群，用自己的血肉和声音（敲击声/噪音）引走丧尸。\",\n        \"emotional_tone\": \"壮烈、悲剧美学\",\n        \"key_scenes\": [\"陈默最后的背影\", \"尸群像潮水般退去\", \"安全屋门外的寂静\"]\n      },\n      {\n        \"chapter_number\": 11,\n        \"chapter_title\": \"录音笔里的三年\",\n        \"core_event\": \"林听在安全屋发现陈默留下的录音笔，里面是三年前（重生前/末世前）他想说却没说出口的告白。\",\n        \"emotional_tone\": \"余韵、哀而不伤\",\n        \"key_scenes\": [\"林听按下播放键\", \"陈默健康时的声音\", \"结局画面：林听带着录音笔走出大楼，迎接黎明\"]\n      }\n    ]\n  }\n}",
                  "path": "outline.json"
                }
              ]
            }
          },
          "thoughtSignature": ""
        }
      ]
