tems\": {\n                \"type\": \"string\"\n              }\n            }\n          }\n        }\n      }\n    },\n    \"selected_recipe\": {\n      \"type\": \"object\",\n      \"description\": \"用户选定的创作配方（X-Y轴化学反应组合）\",\n      \"required\": [\n        \"x_axis_mode_id\",\n        \"x_axis_mode_name\",\n        \"y_axis_tags\",\n        \"reaction_strength\",\n        \"tension_stars\",\n        \"forbidden_elements\"\n      ],\n      \"properties\": {\n        \"x_axis_mode_id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[A-G]\\\\d{1,2}$\",\n          \"enum\": [\n            \"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\",\n            \"B7\", \"B8\", \"B9\", \"B10\", \"B11\", \"B12\",\n            \"C13\", \"C14\", \"C15\", \"C16\", \"C17\", \"C18\",\n            \"D19\", \"D20\", \"D21\", \"D22\", \"D23\",\n            \"E24\", \"E25\", \"E26\", \"E27\", \"E28\",\n            \"F29\", \"F30\", \"F31\", \"F32\", \"F33\", \"F34\",\n            \"G35\", \"G36\"\n          ],\n          \"description\": \"普罗蒂36种剧情模式的标识符\"\n        },\n        \"x_axis_mode_name\": {\n          \"type\": \"string\",\n          \"description\": \"X轴模式的中文名称\"\n        },\n        \"y_axis_tags\": {\n          \"type\": \"array\",\n          \"description\": \"现代网文核心标签（表达载体）\",\n          \"items\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"双向暗恋\",\n              \"系统流\",\n              \"无限流\",\n              \"种田流\",\n              \"赛博朋克\",\n              \"规则怪谈\",\n              \"重生/穿越\",\n              \"商战权谋\",\n              \"克苏鲁\",\n              \"第四天灾\",\n              \"仙侠修真\",\n              \"刑侦悬疑\"\n            ]\n          },\n          \"minItems\": 2,\n          \"maxItems\": 3\n        },\n        \"reaction_strength\": {\n          \"type\": \"string\",\n          \"enum\": [\"↗\", \"↘\", \"✷\"],\n          \"description\": \"X轴与Y轴的化学反应强度符号\"\n        },\n        \"tension_stars\": {\n          \"type\"