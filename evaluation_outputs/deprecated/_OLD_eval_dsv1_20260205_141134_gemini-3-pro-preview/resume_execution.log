                  "content": "{\n  \"main_characters\": [\n    {\n      \"name\": \"沈翊\",\n      \"role\": \"protagonist\",\n      \"identity\": \"刑侦支队副队长\",\n      \"traits\": [\n        \"逻辑缜密\",\n        \"反侦察专家\",\n        \"深情偏执\",\n        \"正义感极强\"\n      ],\n      \"overt_motivation\": \"查清未婚妻杀意真相，活过今晚23:00\",\n      \"covert_motivation\": \"证明未婚妻依然爱自己，寻找两全其美的破局之法\",\n      \"secret_fear\": \"未婚妻真的变心，或者自己成为了正义的对立面\",\n      \"misperception_of_other\": \"认为陆晚被胁迫或精神异常，试图拯救她\",\n      \"hidden_connection\": \"两人是警校同期，曾共同经历过生死案件，默契度极高\"\n    },\n    {\n      \"name\": \"陆晚\",\n      \"role\": \"deuteragonist\",\n      \"identity\": \"市局法医中心主任\",\n      \"traits\": [\n        \"冷静理智\",\n        \"解剖学专家\",\n        \"隐忍\",\n        \"悲剧承担者\"\n      ],\n      \"overt_motivation\": \"在今晚23:00前杀死沈翊\",\n      \"covert_motivation\": \"阻止沈翊触发末日开关，独自背负杀夫的罪孽\",\n      \"secret_fear\": \"沈翊发现真相后选择自杀，留她独活\",\n      \"misperception_of_other\": \"认为沈翊一定会为了职责去救那个证人，无法被说服\",\n      \"hidden_connection\": \"深爱沈翊，为了他的名誉和信仰，选择让他死在自己手里而不是成为千古罪人\"\n    }\n  ],\n  \"supporting_characters\": [\n    {\n      \"name\": \"老张\",\n      \"function\": \"阻碍\",\n      \"identity\": \"刑侦支队队长\",\n      \"description\": \"沈翊的师父，敏锐的老刑警。察觉到沈翊状态异常，试图介入保护，却无意中破坏了陆晚的布局，加速了危机爆发。\"\n    },\n    {\n      \"name\": \"系统\",\n      \"function\": \"助力\",\n      \"identity\": \"高维观测者/预警程序\",\n      \"description\": \"无实体，通过视网膜投影倒计时和概率。冷酷的客观陈述者，不断提示'死亡率100%'，强化宿命感。\"\n    }\n  ],\n  \"relationship_dynamics\": \"极致的双强博弈与虐恋。表面上是猎人与猎物的生死追杀，内核是两个深爱的人为了保护对方（或对方的信仰）而进行的绝望互殴。沈翊越反抗，陆晚越痛苦；陆晚越狠心，沈翊越绝望。\"\n}",
