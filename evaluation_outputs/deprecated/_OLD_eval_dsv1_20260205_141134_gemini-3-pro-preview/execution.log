      "content": "{\"content\": [{\"type\": \"text\", \"text\": \"{\\n  \\\"status\\\": \\\"success\\\",\\n  \\\"path\\\": \\\"chapters/chapter_01.md\\\",\\n  \\\"size\\\": 2821,\\n  \\\"message\\\": \\\"文件已写入: chapters/chapter_01.md\\\"\\n}\"}], \"isError\": false}"
