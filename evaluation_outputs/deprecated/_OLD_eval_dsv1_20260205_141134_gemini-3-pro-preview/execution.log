\\n          \\\\\\\"function\\\\\\\": {\\\\n            \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n            \\\\\\\"enum\\\\\\\": [\\\\\\\"助力\\\\\\\", \\\\\\\"阻碍\\\\\\\", \\\\\\\"反转点\\\\\\\"],\\\\n            \\\\\\\"description\\\\\\\": \\\\\\\"对主角的作用类型\\\\\\\"\\\\n          },\\\\n          \\\\\\\"identity\\\\\\\": {\\\\n            \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n            \\\\\\\"description\\\\\\\": \\\\\\\"配角身份\\\\\\\"\\\\n          },\\\\n          \\\\\\\"description\\\\\\\": {\\\\n            \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n            \\\\\\\"description\\\\\\\": \\\\\\\"配角简要描述\\\\\\\"\\\\n          }\\\\n        }\\\\n      }\\\\n    },\\\\n    \\\\\\\"relationship_dynamics\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"角色关系动态描述\\\\\\\"\\\\n    }\\\\n  }\\\\n}\\\\n\\\",\\n  \\\"size\\\": 2564\\n}\"}], \"isError\": false}"
