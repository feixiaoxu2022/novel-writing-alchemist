 \\\\\\\"array\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"适合发布的平台类型\\\\\\\",\\\\n          \\\\\\\"items\\\\\\\": {\\\\n            \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\"\\\\n          }\\\\n        }\\\\n      }\\\\n    },\\\\n    \\\\\\\"one_sentence_synopsis\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"一句话故事梗概（30-50字）\\\\\\\",\\\\n      \\\\\\\"minLength\\\\\\\": 30,\\\\n      \\\\\\\"maxLength\\\\\\\": 50\\\\n    }\\\\n  }\\\\n}\\\\n\\\",\\n  \\\"size\\\": 4455\\n}\"}], \"isError\": false}"
