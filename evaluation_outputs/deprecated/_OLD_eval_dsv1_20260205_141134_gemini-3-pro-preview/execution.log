\\\"forbidden_elements\\\\\\\"\\\\n      ],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"x_axis_mode_id\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n          \\\\\\\"pattern\\\\\\\": \\\\\\\"^[A-G]\\\\\\\\\\\\\\\\d{1,2}$\\\\\\\",\\\\n          \\\\\\\"enum\\\\\\\": [\\\\n            \\\\\\\"A1\\\\\\\", \\\\\\\"A2\\\\\\\", \\\\\\\"A3\\\\\\\", \\\\\\\"A4\\\\\\\", \\\\\\\"A5\\\\\\\", \\\\\\\"A6\\\\\\\",\\\\n            \\\\\\\"B7\\\\\\\", \\\\\\\"B8\\\\\\\", \\\\\\\"B9\\\\\\\", \\\\\\\"B10\\\\\\\", \\\\\\\"B11\\\\\\\", \\\\\\\"B12\\\\\\\",\\\\n            \\\\\\\"C13\\\\\\\", \\\\\\\"C14\\\\\\\", \\\\\\\"C15\\\\\\\", \\\\\\\"C16\\\\\\\", \\\\\\\"C17\\\\\\\", \\\\\\\"C18\\\\\\\",\\\\n            \\\\\\\"D19\\\\\\\", \\\\\\\"D20\\\\\\\", \\\\\\\"D21\\\\\\\", \\\\\\\"D22\\\\\\\", \\\\\\\"D23\\\\\\\",\\\\n            \\\\\\\"E24\\\\\\\", \\\\\\\"E25\\\\\\\", \\\\\\\"E26\\\\\\\", \\\\\\\"E27\\\\\\\", \\\\\\\"E28\\\\\\\",\\\\n            \\\\\\\"F29\\\\\\\", \\\\\\\"F30\\\\\\\", \\\\\\\"F31\\\\\\\", \\\\\\\"F32\\\\\\\", \\\\\\\"F33\\\\\\\", \\\\\\\"F34\\\\\\\",\\\\n            \\\\\\\"G35\\\\\\\", \\\\\\\"G36\\\\\\\"\\\\n          ],\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"普罗蒂36种剧情模式的标识符\\\\\\\"\\\\n        },\\\\n        \\\\\\\"x_axis_mode_name\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"X轴模式的中文名称\\\\\\\"\\\\n        },\\\\n        \\\\\\\"y_axis_tags\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"现代网文核心标签（表达载体）\\\\\\\",\\\\n          \\\\\\\"items\\\\\\\": {\\\\n            \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n            \\\\\\\"enum\\\\\\\": [\\\\n              \\\\\\\"双向暗恋\\\\\\\",\\\\n              \\\\\\\"系统流\\\\\\\",\\\\n              \\\\\\\"无限流\\\\\\\",\\\\n              \\\\\\\"种田流\\\\\\\",\\\\n              \\\\\\\"赛博朋克\\\\\\\",\\\\n           