            "arguments": "{\"files\":[{\"content\":\"{\\n  \\\"protagonists\\\": [\\n    {\\n      \\\"name\\\": \\\"陈锋\\\",\\n      \\\"age\\\": 26,\\n      \\\"role\\\": \\\"倒爷 / 摩托车手\\\",\\n      \\\"traits\\\": [\\\"野性难驯\\\", \\\"赌徒心态\\\", \\\"深情隐忍\\\", \\\"江湖气\\\"],\\n      \\\"goals\\\": {\\n        \\\"explicit\\\": \\\"将这批货运到北方卖个好价钱\\\",\\n        \\\"implicit\\\": \\\"赚够娶林晚的钱，给她一个安稳的家\\\"\\n      },\\n      \\\"fears\\\": \\\"生意失败无法兑现承诺，配不上林晚\\\",\\n      \\\"secret\\\": \\\"这批货是孤注一掷，风险极大，几乎是赌命\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"林晚\\\",\\n      \\\"age\\\": 24,\\n      \\\"role\\\": \\\"下岗女工\\\",\\n      \\\"traits\\\": [\\\"外柔内刚\\\", \\\"沉默观察\\\", \\\"决断力强\\\", \\\"细腻\\\"],\\n      \\\"goals\\\": {\\n        \\\"explicit\\\": \\\"押货赚取佣金\\\",\\n        \\\"implicit\\\": \\\"陪陈锋走完这一程，无论结果如何\\\"\\n      },\\n      \\\"fears\\\": \\\"陈锋出事，或者陈锋因为自卑推开她\\\",\\n      \\\"secret\\\": \\\"早就知道陈锋的心意，地图上标记的是心形而非路线\\\"\\n    }\\n  ],\\n  \\\"supporting_characters\\\": [\\n    {\\n      \\\"name\\\": \\\"路霸/同行\\\",\\n      \\\"role\\\": \\\"反派/阻碍\\\",\\n      \\\"function\\\": \\\"制造外部危机，展现陈锋的保护欲和江湖生存的残酷\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"供销社售货员\\\",\\n      \\\"role\\\": \\\"过客\\\",\\n      \\\"function\\\": \\\"见证者，对购买大量枕巾行为的侧面描写\\\"\\n    }\\n  ],\\n  \\\"relationships\\\": [\\n    {\\n      \\\"source\\\": \\\"陈锋\\\",\\n      \\\"target\\\": \\\"林晚\\\",\\n      \\\"description\\\": \\\"深爱但不敢言，觉得必须有了物质基础才有资格娶她。视她为生命中唯一的柔软。\\\"\\n    },\\n    {\\n      \\\"source\\\": \\\"林晚\\\",\\n      \\\"target\\\": \\\"陈锋\\\",\\n      \\\"description\\\": \\\"深知他的脆弱与逞强，愿意包容他的一切，比他更早看清未来的方向。\\\"\\n    }\\n  ]\\n}\",\"path\":\"characters.json\"},{\"content\":\"{\\n  \\\"structure\\\": \\\"三幕式\\\",\\n  \\\"acts\\\": [\\n    {\\n      \\\"name\\\": \\\"第一幕：金属茧\\\",\\n      \\\"chapters\\\": [\\n        {\\n          \\\"id\\\": 1,\\n          \\\"title\\\": \\\"暴雨中的嘉陵\\\",\\n          \\\"summary\\\": \\\"1992年暴雨，陈锋骑摩托载着林晚在国道飞驰。回顾两人关系与契约。第一次停车买鸳鸯枕巾，塞进边斗。建立封闭空间与压抑的情感基调。\\\",\\n          \\\"word_count_target\\\": 2000\\n        }\\n      ]\\n    },\\n    {\\n      \\\"name\\\": \\\"第二幕：流浪婚礼\\\",\\n      \\\"chapters\\\": [\\n        {\\n          \\\"id\\\": 2,\\n          \\\"title\\\": \\\"红丝巾与路霸\\\",\\n          \\\"summary\\\": \\\"旅途切片。暴风雨中陈锋停车买红丝巾。遭遇路霸或同行竞争，陈锋展现狠厉一面保护林晚。情感在危机中升温。\\\",\\n          \\\"word_count_target\\\": 2500\\n        },\\n        {\\n          \\\"id\\\": 3,\\n          \\\"title\\\": \\\"一万张婚床\\\",\\n          \\\"summary\\\": \\\"桥洞过夜。陈锋铺开沿途买的所有枕巾，说出“一万张婚床”。到达目的地前夜，陈锋说出赌约：“赚了娶你，赔了摩托归你，我归摩托”。\\\",\\n          \\\"word_count_target\\\": 2500\\n        }\\n      ]\\n    },\\n    {\\n      \\\"name\\\": \\\"第三幕：深圳车票\\\",\\n      \\\"chapters\\\": [\\n        {\\n          \\\"id\\\": 4,\\n          \\\"title\\\": \\\"向死而生\\\",\\n          \\\"summary\\\": \\\"货物血本无归。陈锋绝望欲履行“归摩托”的诺言。林晚卖掉摩托，买了两张去深圳的车票。两人踏上新的旅程，林晚系上红丝巾。\\\",\\n          \\\"word_count_target\\\": 2000\\n        }\\n      ]\\n    }\\n  ]\\n}\",\"path\":\"outline.json\"}]}"
