          "function": {
            "name": "novel_writing_service__write_files",
            "arguments": "{\"files\":[{\"content\":\"{\\n  \\\"protagonist_female\\\": {\\n    \\\"name\\\": \\\"林听\\\",\\n    \\\"age\\\": 22,\\n    \\\"role\\\": \\\"盲人配音演员 / 生存者\\\",\\n    \\\"traits\\\": [\\n      \\\"听觉超敏（能听见丧尸关节摩擦声）\\\",\\n      \\\"内心敏感坚韧\\\",\\n      \\\"脑补能力强（自我合理化“系统”设定）\\\"\\n    ],\\n    \\\"motivation\\\": {\\n      \\\"explicit\\\": \\\"跟随“系统”指引逃离录音棚\\\",\\n      \\\"implicit\\\": \\\"依赖这个唯一能与她交流的“存在”，渴望在末世后见到“它”\\\"\\n    },\\n    \\\"misconception\\\": \\\"将耳机里的摩斯密码/敲击声当成系统UI提示音；将江默的狙击枪声当成系统自动防御机制。\\\"\\n  },\\n  \\\"protagonist_male\\\": {\\n    \\\"name\\\": \\\"江默\\\",\\n    \\\"age\\\": 26,\\n    \\\"role\\\": \\\"失语狙击手 / 重生守护者\\\",\\n    \\\"traits\\\": [\\n      \\\"失语（声带在前世保护女主时撕裂，重生带回了伤势/或心理性失语）\\\",\\n      \\\"神级狙击技术\\\",\\n      \\\"深情隐忍\\\"\\n    ],\\n    \\\"motivation\\\": {\\n      \\\"explicit\\\": \\\"利用前世经验和狙击技术死守录音棚\\\",\\n      \\\"implicit\\\": \\\"这一世即使化作厉鬼也要护她周全，绝不重蹈覆辙\\\"\\n    },\\n    \\\"secret\\\": \\\"拥有前世记忆；录音笔里藏着三年前未宣之于口的告白；现在的“系统”身份是无奈的伪装。\\\"\\n  },\\n  \\\"supporting_characters\\\": [\\n    {\\n      \\\"name\\\": \\\"丧尸群\\\",\\n      \\\"role\\\": \\\"环境反派\\\",\\n      \\\"traits\\\": [\\\"听觉敏感型变异\\\", \\\"数量庞大\\\"]\\n    }\\n  ]\\n}\",\"path\":\"characters.json\"},{\"content\":\"{\\n  \\\"act_one\\\": {\\n    \\\"title\\\": \\\"第一幕：黑暗中的“金手指” (0-15%)\\\",\\n    \\\"chapters\\\": \\\"1-3章\\\",\\n    \\\"summary\\\": \\\"丧尸病毒爆发当晚，盲女林听被困在隔音极好的录音棚。重生归来的江默潜伏在对面大楼/或录音棚监控室，因喉咙受损无法发声。当丧尸逼近林听时，江默接入她的耳机，通过敲击声（摩斯密码节奏）指引她躲避。惊恐中的林听将这种精准的上帝视角指引误认为是末世小说里的“生存系统”。\\\",\\n    \\\"inciting_incident\\\": \\\"丧尸破门而入的瞬间，耳机里传来“滴-滴”两声急促提示（左闪），林听下意识照做，一颗子弹擦着她耳边击穿丧尸头颅。林听以为是“系统新手大礼包：自动防御”。\\\"\\n  },\\n  \\\"act_two\\\": {\\n    \\\"title\\\": \\\"第二幕：双向奔赴的误解 (15%-75%)\\\",\\n    \\\"chapters\\\": \\\"4-12章\\\",\\n    \\\"summary\\\": \\\"两人开始奇特的共生模式。林听负责在录音棚内利用专业设备录制不同频率的“人声诱饵”，通过广播系统调动丧尸走向；江默则在暗处狙击。林听对“系统”产生依赖，甚至会在耳机里碎碎念，把“系统”当成树洞。江默只能听不能说，偶尔用敲击声回应她的情绪，这种沉默被林听解读为“系统的高冷”。\\\",\\n    \\\"midpoint\\\": \\\"物资告急，林听必须冒险去楼下贩卖机。江默为了掩护她，不得不近身肉搏，受了伤。耳机里传来沉重的呼吸声和压抑的咳嗽声。林听疑惑：“系统也会累吗？”她第一次产生了想“见一见系统实体”的念头。\\\",\\n    \\\"rising_action\\\": \\\"尸潮开始聚集，变异丧尸出现（听觉进化）。“人声诱饵”战术失效，录音棚面临围攻。江默意识到重生也无法改变绝境，D21模式（为亲人牺牲）的前奏启动。\\\"\\n  },\\n  \\\"act_three\\\": {\\n    \\\"title\\\": \\\"第三幕：无声的告白 (75%-100%)\\\",\\n    \\\"chapters\\\": \\\"13-16章\\\",\\n    \\\"summary\\\": \\\"最后的一夜。江默制定了必死的计划：他去开启外部扩音器引走尸群，给林听留出逃生通道。他通过耳机发布“最终主线任务：活下去”。林听察觉不对劲，拼命追问。江默切断通讯，冲入尸群。林听在撤离路线上绊倒，摸到了江默特意留下的旧录音笔。按下播放键的瞬间，三年前熟悉的声音与耳机里刚才的敲击声重叠。\\\",\\n    \\\"climax\\\": \\\"林听在录音笔的告白声中，听着耳机里传来的最后枪响和重物倒地声。她终于明白了一切。\\\",\\n    \\\"resolution\\\": \\\"林听独自活了下来，带着录音笔。她闭上眼，仿佛还能听见那指引她前行的敲击声。BE美学达成。\\\"\\n  }\\n}\",\"path\":\"outline.json\"}]}"
          }
        }
