  "id": "chatcmpl-20260204202512200039336NXL5trhy",
  "model": "gemini-3-pro-preview",
  "object": "chat.completion",
  "created": 1770207937,
  "choices": [
    {
      "index": 0,
      "message": {
        "role": "assistant",
