            "arguments": "{\"files\":[{\"content\":\"{\\n  \\\"protagonist\\\": {\\n    \\\"name\\\": \\\"林沉\\\",\\n    \\\"age\\\": 32,\\n    \\\"role\\\": \\\"黑市记忆修复师\\\",\\n    \\\"traits\\\": [\\n      \\\"孤僻冷漠\\\",\\n      \\\"技术顶尖但使用老式设备\\\",\\n      \\\"深情隐忍\\\"\\n    ],\\n    \\\"appearance\\\": \\\"苍白消瘦，右眼是泛着冷光的义眼，手指修长指尖有茧\\\",\\n    \\\"motivation\\\": {\\n      \\\"explicit\\\": \\\"完成订单赚取维护义眼的费用\\\",\\n      \\\"implicit\\\": \\\"寻找十年前初恋死亡的真相，或仅仅是无法放下的执念\\\"\\n    },\\n    \\\"equipment\\\": \\\"一把十年前的Cherry G80-3000机械键盘，作为连接现实与数据的物理锚点\\\"\\n  },\\n  \\\"antagonist\\\": {\\n    \\\"name\\\": \\\"时间与熵\\\",\\n    \\\"role\\\": \\\"不可抗力\\\",\\n    \\\"traits\\\": [\\n      \\\"不可逆转\\\",\\n      \\\"残酷\\\"\\n    ],\\n    \\\"manifestation\\\": \\\"数据腐蚀、逻辑崩坏、遗忘\\\"\\n  },\\n  \\\"supporting_characters\\\": [\\n    {\\n      \\\"name\\\": \\\"夏微 (AI)\\\",\\n      \\\"role\\\": \\\"非法上传的意识副本 / 初恋\\\",\\n      \\\"traits\\\": [\\n        \\\"温柔倔强\\\",\\n        \\\"永远的22岁\\\",\\n        \\\"逐渐崩坏\\\"\\n      ],\\n      \\\"state\\\": \\\"存储在老式硬盘中，核心代码包裹着未送出的情书\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"老K\\\",\\n      \\\"role\\\": \\\"黑市中介\\\",\\n      \\\"traits\\\": [\\n        \\\"唯利是图\\\",\\n        \\\"消息灵通\\\"\\n      ],\\n      \\\"function\\\": \\\"提供任务，施加外部时间压力（网警搜查）\\\"\\n    }\\n  ]\\n}\",\"path\":\"characters.json\"},{\"content\":\"{\\n  \\\"act_one\\\": {\\n    \\\"title\\\": \\\"旧日的幽灵\\\",\\n    \\\"word_count_target\\\": 4000,\\n    \\\"key_events\\\": [\\n      \\\"林沉在雨夜接到老K的加急订单，修复一个损坏严重的非法AI。\\\",\\n      \\\"林沉连接设备，进入数据空间，发现AI的数据特征异常熟悉。\\\",\\n      \\\"修复第一层记忆碎片：十年前大学图书馆的雨声，那是他们初遇的场景。\\\",\\n      \\\"林沉确认AI竟是十年前死于车祸的初恋夏微，震惊与痛苦交织。\\\"\\n    ],\\n    \\\"tension_point\\\": \\\"当数据碎片拼凑出夏微的脸庞，林沉平静的生活瞬间崩塌。\\\"\\n  },\\n  \\\"act_two\\\": {\\n    \\\"title\\\": \\\"情书与病毒\\\",\\n    \\\"word_count_target\\\": 6000,\\n    \\\"key_events\\\": [\\n      \\\"夏微的意识逐渐苏醒，但记忆混乱，误以为自己还活着。\\\",\\n      \\\"林沉在虚拟空间陪伴夏微，重温过去的点滴，同时小心翼翼地修复受损代码。\\\",\\n      \\\"随着修复深入，林沉触碰到核心加密区，发现那是夏微死前拼命想要留下的东西——一封未送出的情书。\\\",\\n      \\\"情书内容揭示了当年的双向暗恋，林沉痛哭。\\\",\\n      \\\"此时，底层代码开始逻辑崩坏（病毒/数据熵增），夏微开始感到剧痛，形象扭曲。\\\"\\n    ],\\n    \\\"tension_point\\\": \\\"美好的回忆与残酷的崩坏同时发生，林沉意识到修复就是加速她的毁灭。\\\"\\n  },\\n  \\\"act_three\\\": {\\n    \\\"title\\\": \\\"第九十九个百分点\\\",\\n    \\\"word_count_target\\\": 5000,\\n    \\\"key_events\\\": [\\n      \\\"网警锁定林沉的坐标，老K催促销毁证据。\\\",\\n      \\\"夏微在崩坏中恢复了清醒，明白了自己已死的事实。\\\",\\n      \\\"进度条走到99%，夏微请求林沉履行当年的玩笑承诺：“如果我变成数据怪物，你要亲手删掉我。”\\\",\\n      \\\"林沉手指悬停在Delete键上，内心进行激烈的挣扎（存在的重量）。\\\",\\n      \\\"最后时刻，林沉按下删除键。夏微微笑着消散。\\\",\\n      \\\"现实回归死寂，屏幕上跳出情书的最后一句：“我爱你，再见。”\\\"\\n    ],\\n    \\\"tension_point\\\": \\\"手指悬停在键盘上的那一刻，生与死、爱与放手的终极抉择。\\\"\\n  }\\n}\",\"path\":\"outline.json\"}]}"
