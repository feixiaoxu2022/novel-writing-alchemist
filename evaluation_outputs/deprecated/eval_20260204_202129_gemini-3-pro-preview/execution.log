      "content": "{\"content\": [{\"type\": \"text\", \"text\": \"{\\n  \\\"status\\\": \\\"success\\\",\\n  \\\"path\\\": \\\"chapters\\\",\\n  \\\"message\\\": \\\"目录已创建: chapters\\\"\\n}\"}], \"isError\": false}"
