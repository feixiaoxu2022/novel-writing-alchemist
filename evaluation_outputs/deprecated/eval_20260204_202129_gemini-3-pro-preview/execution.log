            "arguments": "{\"content\":\"{\\n  \\\"title\\\": \\\"流浪婚礼：1992\\\",\\n  \\\"concept\\\": \\\"1992年倒爷与下岗女工骑摩托穿州过省的流浪婚礼，以枕巾为聘礼，以摩托为婚房，最终在生意失败中迎来新生。\\\",\\n  \\\"x_axis\\\": {\\n    \\\"id\\\": \\\"B12\\\",\\n    \\\"name\\\": \\\"获取 (Obtaining)\\\",\\n    \\\"definition\\\": \\\"谋取者通过各种手段从拒绝者/守门人处获取目标\\\",\\n    \\\"manifestation\\\": \\\"男主试图通过倒卖货物获取财富（未来的保障）和女主（通过赌约娶她）。\\\"\\n  },\\n  \\\"y_axis\\\": {\\n    \\\"tags\\\": [\\\"双向暗恋\\\", \\\"商战权谋\\\"],\\n    \\\"effect\\\": \\\"商战权谋（倒爷江湖的残酷博弈）为双向暗恋增加了现实的重力和悲剧的必然性（↘ 中度反应）。\\\"\\n  },\\n  \\\"reaction_strength\\\": \\\"↘\\\",\\n  \\\"tension_level\\\": \\\"★★★★☆\\\",\\n  \\\"platform\\\": \\\"知乎盐选/豆瓣阅读\\\",\\n  \\\"forbidden_elements\\\": [\\\"不要穿越\\\", \\\"不要系统\\\", \\\"不要过于现代的语言风格\\\"],\\n  \\\"target_length\\\": \\\"6500-10000字\\\"\\n}\",\"path\":\"creative_intent.json\"}"
          }
