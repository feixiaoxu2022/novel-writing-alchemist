            "arguments": "{\"files\":[{\"content\":\"{\\n    \\\"protagonist\\\": {\\n        \\\"name\\\": \\\"沈翊\\\",\\n        \\\"age\\\": 29,\\n        \\\"occupation\\\": \\\"市局刑侦支队副队长\\\",\\n        \\\"traits\\\": [\\\"直觉敏锐\\\", \\\"深情隐忍\\\", \\\"系统持有者\\\"],\\n        \\\"goal\\\": \\\"在12小时内查清未婚妻杀自己的真相，并活下来阻止灾难\\\",\\n        \\\"secret\\\": \\\"拥有可以看到罪恶倒计时的系统\\\",\\n        \\\"weakness\\\": \\\"对林语冰毫无保留的信任与爱\\\"\\n    },\\n    \\\"antagonist\\\": {\\n        \\\"name\\\": \\\"林语冰\\\",\\n        \\\"age\\\": 27,\\n        \\\"occupation\\\": \\\"市局法医科主任\\\",\\n        \\\"traits\\\": [\\\"高智商\\\", \\\"极度冷静\\\", \\\"手术刀般精准\\\"],\\n        \\\"goal\\\": \\\"杀死沈翊（为了阻止他去送死并拯救城市）\\\",\\n        \\\"secret\\\": \\\"早已发现沈翊的系统规律（误解），并被神秘组织威胁\\\",\\n        \\\"motivation\\\": \\\"电车难题：牺牲爱人，拯救千万人\\\"\\n    },\\n    \\\"supporting_characters\\\": [\\n        {\\n            \\\"name\\\": \\\"陈默\\\",\\n            \\\"role\\\": \\\"关键证人/伪装反派\\\",\\n            \\\"description\\\": \\\"表面是掌握洗钱证据的会计，实则是携带生化病毒的人体炸弹。沈翊若接近他，必死无疑且会引爆病毒。\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"老张\\\",\\n            \\\"role\\\": \\\"刑侦老刑警\\\",\\n            \\\"description\\\": \\\"沈翊的师父，察觉到两人的异常，试图介入\\\"\\n        }\\n    ]\\n}\",\"path\":\"characters.json\"},{\"content\":\"{\\n    \\\"act_one\\\": {\\n        \\\"title\\\": \\\"倒计时：12小时\\\",\\n        \\\"summary\\\": \\\"沈翊在晨起时发现未婚妻林语冰额头出现血色倒计时：'23:00 确认击杀'。系统判定'不可更改'。沈翊试图通过请假、躲避等方式改变未来，但倒计时如影随形。他开始利用刑侦手段反侦察林语冰，发现她在暗网购买了神经毒素，并精心策划了一场'密室谋杀'。沈翊心碎之余，在审讯室外与林语冰进行了一场暗语交锋，确认了她的杀意。\\\",\\n        \\\"key_points\\\": [\\n            \\\"开篇：系统能力的展示与日常的温馨打破\\\",\\n            \\\"激励事件：看到林语冰额头的死亡预告\\\",\\n            \\\"发展：沈翊的尝试规避失败，转为调查\\\",\\n            \\\"情节点1：确认林语冰确实在筹备谋杀，且手段专业致命\\\"\\n        ]\\n    },\\n    \\\"act_two\\\": {\\n        \\\"title\\\": \\\"博弈：爱与谎言\\\",\\n        \\\"summary\\\": \\\"沈翊深入调查，发现林语冰的目标不仅仅是杀他。他追踪到关键证人陈默的线索，发现陈默并非普通证人，而是代号'瘟疫'的恐怖分子。若沈翊按原计划今晚去安全屋提审陈默，陈默体内的生物炸弹将感应沈翊的生物波（或特定信号）引爆，导致全城感染。林语冰得知此情报，被威胁不能说出真相，只能选择在沈翊出发前'杀'了他。沈翊理解了真相，决定将计就计。他利用系统判定逻辑（生理性死亡即任务完成），暗示林语冰使用一种能造成假死状态的河豚毒素变种。\\\",\\n        \\\"key_points\\\": [\\n            \\\"中点：沈翊查明陈默真相，理解了林语冰的'电车难题'\\\",\\n            \\\"冲突：沈翊与林语冰的无声默契，两人在监控下互飙演技\\\",\\n            \\\"情节点2：沈翊发现系统漏洞，决定赌命进行'假死'计划\\\"\\n        ]\\n    },\\n    \\\"act_three\\\": {\\n        \\\"title\\\": \\\"终局：第十三小时\\\",\\n        \\\"summary\\\": \\\"23:00，林语冰在'最后的晚餐'中动手。沈翊配合喝下毒酒，心脏停跳。系统判定沈翊死亡，倒计时消失。林语冰在极限时间内进行抢救（或注射解毒剂）。此时陈默察觉异常试图逃离，被'尸体'复活的沈翊绝地反杀。危机解除。但因假死时间过长，沈翊视神经受损永久失明（缺憾）。林语冰因故意杀人未遂（监控铁证）及私藏违禁药物自首入狱，为了保护沈翊系统的秘密，她选择独自承担一切罪名。\\\",\\n        \\\"key_points\\\": [\\n            \\\"高潮：23:00的毒杀与假死操作，生死一线\\\",\\n            \\\"反转：沈翊'复活'击败陈默\\\",\\n            \\\"结局：沈翊失明，林语冰入狱。两人隔着探视窗，沈翊虽然看不见，但手掌贴合在玻璃上，确认了彼此的爱意。\\\"\\n        ]\\n    }\\n}\",\"path\":\"outline.json\"}]}"
