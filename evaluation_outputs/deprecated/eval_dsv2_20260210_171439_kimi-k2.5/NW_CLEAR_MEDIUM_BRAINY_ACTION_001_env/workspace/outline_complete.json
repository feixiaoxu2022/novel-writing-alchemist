      {"chapter_number": 18, "chapter_title": "剧场核心", "chapter_synopsis": "进入最终副本《剧场核心》，这是一个综合了之前所有副本元素的终极试炼，他们必须一一突破。", "scene_sequence": [{"scene_number": 1, "scene_location": "剧场核心大厅", "characters_present": ["苟小闲", "周影"], "scene_purpose": "引入最终副本", "core_action": "发现这里融合了所有之前的副本元素", "conflict_point": "零号管理员出现说欢迎来到终点", "emotional_shift": "从震惊到冷静", "scene_outcome": "开始第一关"}, {"scene_number": 2, "scene_location": "核心副本第一层", "characters_present": ["苟小闲", "周影"], "scene_purpose": "突破", "core_action": "重现《午夜电梯》场景但更难", "conflict_point": "规则有变化", "emotional_shift": "从冷静到紧张", "scene_outcome": "用新规则漏洞突破"}, {"scene_number": 3, "scene_location": "核心副本第二层", "characters_present": ["苟小闲", "周影"], "scene_purpose": "继续突破", "core_action": "重现《迷失医院》场景", "conflict_point": "鬼怪是之前遇到的玩家", "emotional_shift": "从紧张到悲愤", "scene_outcome": "突破第二层"}], "emotional_tone": "压抑"},
