{
  "act_one": {
    "description": "建立世界观，主角被迫进入剧场系统",
    "story_synopsis": "苟小闲被困入剧场，在《午夜电梯》靠规则漏洞存活，遇到周影。两人通关《迷失医院》，发现苟小闲入职日期与剧场启动日期相同。白夜揭示苟小闲是原生NPC觉醒者，管理员确认他是系统创造的第一个意识体。",
    "key_chapters": [
      {"chapter_number": 1, "chapter_title": "加班社畜的福报", "chapter_synopsis": "苟小闲点击奇怪广告被拽入剧场，管理员宣布必须通关副本才能存活。", "scene_sequence": [{"scene_number": 1, "scene_location": "深夜写字楼电梯间", "characters_present": ["苟小闲"], "scene_purpose": "引入神秘事件开端", "core_action": "苟小闲点击全息广告后被拽入镜面", "conflict_point": "镜面伸出苍白的手", "emotional_shift": "从疲惫到恐惧", "scene_outcome": "陷入昏迷"}, {"scene_number": 2, "scene_location": "白色圆形大厅", "characters_present": ["苟小闲", "零号管理员", "其他玩家"], "scene_purpose": "建立剧场世界观", "core_action": "管理员宣布规则，不相信的玩家被分解", "conflict_point": "玩家死亡证明这是真正的生死场", "emotional_shift": "从侥幸到恐惧", "scene_outcome": "获得编号#9527进入副本"}, {"scene_number": 3, "scene_location": "老旧电梯内", "characters_present": ["苟小闲", "其他玩家"], "scene_purpose": "引入副本规则", "core_action": "广播响起规则，违反者被压成肉泥", "conflict_point": "规则真实性被证实", "emotional_shift": "从恐惧到求生本能", "scene_outcome": "开始观察寻找漏洞"}], "emotional_tone": "悬疑恐惧"},
      {"chapter_number": 2, "chapter_title": "规则漏洞", "chapter_synopsis": "苟小闲发现电梯12层外面是安全走廊，引诱无头女尸追出后用电梯门夹断她脖子通关。", "scene_sequence": [{"scene_number": 1, "scene_location": "电梯内，门外是血海", "characters_present": ["苟小闲", "其他玩家", "无头女尸"], "scene_purpose": "展示危险性，开始观察", "core_action": "注意到无头女尸只在电梯内活动", "conflict_point": "每次开门都是恐怖场景", "emotional_shift": "从恐惧到冷静", "scene_outcome": "发现12层外面是正常走廊"}, {"scene_number": 2, "scene_location": "12层走廊", "characters_present": ["苟小闲", "无头女尸"], "scene_purpose": "执行计划", "core_action": "引诱女尸追出电梯，门夹断脖子", "conflict_point": "关门速度和女尸反应赛跑", "emotional_shift": "从冷静到紧张", "scene_outcome": "副本通关"}, {"scene_number": 3, "scene_location": "白色大厅", "characters_present": ["苟小闲", "零号管理员"], "scene_purpose": "展示奖励", "core_action": "获得100积分和破碎的镜面碎片", "conflict_point": "暗示从来没有人通关最高层", "emotional_shift": "从庆幸到绝望", "scene_outcome": "传送回现实"}], "emotional_tone": "紧张刺激"},
      {"chapter_number": 3, "chapter_title": "资深玩家", "chapter_synopsis": "苟小闲发现同事老吴也是玩家，通过老吴认识情报商人钱多多。", "scene_sequence": [{"scene_number": 1, "scene_location": "苟小闲出租屋", "characters_present": ["苟小闲"], "scene_purpose": "展示回到现实的混乱", "core_action": "发现伤和道具都是真实的", "conflict_point": "意识到7天后还要进副本", "emotional_shift": "从侥幸到接受", "scene_outcome": "决定寻找其他玩家"}, {"scene_number": 2, "scene_location": "公司茶水间", "characters_present": ["苟小闲", "老吴"], "scene_purpose": "引入老吴", "core_action": "两人确认玩家身份", "conflict_point": "老吴警告知道越多越危险", "emotional_shift": "从孤立到安慰", "scene_outcome": "获得钱多多联系方式"}, {"scene_number": 3, "scene_location": "城中村地下室", "characters_present": ["苟小闲", "钱多多"], "scene_purpose": "引入钱多多", "core_action": "购买《剧场新人生存手册》", "conflict_point": "警告是游戏在玩你", "emotional_shift": "从好奇到警惕", "scene_outcome": "得知将进入《迷失医院》"}], "emotional_tone": "悬疑"},
      {"chapter_number": 4, "chapter_title": "迷失医院", "chapter_synopsis": "苟小闲进入副本遇到周影，发现蓝牌医生是友方NPC救了周影。", "scene_sequence": [{"scene_number": 1, "scene_location": "医院挂号大厅", "characters_present": ["苟小闲", "周影", "其他玩家"], "scene_purpose": "引入副本和周影", "core_action": "周影逼退抢劫者", "conflict_point": "广播播报规则", "emotional_shift": "从紧张到无奈", "scene_outcome": "开始观察"}, {"scene_number": 2, "scene_location": "医院走廊", "characters_present": ["苟小闲", "周影", "红胸牌医生"], "scene_purpose": "救下周影", "core_action": "发现蓝牌医生给钥匙指路", "conflict_point": "周影不信任苟小闲", "emotional_shift": "从不信任到惊讶", "scene_outcome": "甩掉红牌医生"}, {"scene_number": 3, "scene_location": "安全楼梯间", "characters_present": ["苟小闲", "周影"], "scene_purpose": "建立合作关系", "core_action": "周影询问怎么发现区别", "conflict_point": "透露已在剧场三年", "emotional_shift": "从防备到信任", "scene_outcome": "决定组队"}], "emotional_tone": "紧张合作"},
      {"chapter_number": 5, "chapter_title": "生路", "chapter_synopsis": "苟小闲发现安全楼梯倒着走可以通行，在档案室发现入职日期与剧场启动日期相同。", "scene_sequence": [{"scene_number": 1, "scene_location": "三楼走廊", "characters_present": ["苟小闲", "周影", "其他玩家"], "scene_purpose": "发现生路", "core_action": "发现楼梯标识倒着写，倒着走可以通行", "conflict_point": "周影质疑方法荒唐", "emotional_shift": "从焦虑到兴奋", "scene_outcome": "开始倒着走"}, {"scene_number": 2, "scene_location": "顶楼档案室", "characters_present": ["苟小闲", "周影"], "scene_purpose": "揭示线索", "core_action": "发现名单，入职日期和剧场启动日期是同一天", "conflict_point": "巧合太诡异", "emotional_shift": "从喜悦到不安", "scene_outcome": "带着疑问通关"}, {"scene_number": 3, "scene_location": "白色大厅", "characters_present": ["苟小闲", "周影", "零号管理员"], "scene_purpose": "管理员暗示", "core_action": "获得破损员工证", "conflict_point": "说剧场选择你是有原因的", "emotional_shift": "从不安到恐惧", "scene_outcome": "回到现实调查"}], "emotional_tone": "悬疑不安"},
      {"chapter_number": 6, "chapter_title": "调查", "chapter_synopsis": "苟小闲调查发现入职异常，老吴也是同一天被同个HR招入。周影弟弟失踪时间也是同一天。", "scene_sequence": [{"scene_number": 1, "scene_location": "公司档案室", "characters_present": ["苟小闲"], "scene_purpose": "展示主动性", "core_action": "发现档案缺少面试记录，HR查无此人", "conflict_point": "怀疑被特意安排", "emotional_shift": "从被动到主动", "scene_outcome": "找老吴对质"}, {"scene_number": 2, "scene_location": "公司天台", "characters_present": ["苟小闲", "老吴"], "scene_purpose": "揭示共同点", "core_action": "老吴承认也是同一天被同个HR招入", "conflict_point": "老吴选择装不知道", "emotional_shift": "从怀疑到震惊", "scene_outcome": "得知周影也在调查"}, {"scene_number": 3, "scene_location": "咖啡馆", "characters_present": ["苟小闲", "周影"], "scene_purpose": "揭示原生程序", "core_action": "展示弟弟失踪记录和员工证", "conflict_point": "看到原生程序禁止删除", "emotional_shift": "从各自为战到同盟", "scene_outcome": "决定联手调查"}], "emotional_tone": "悬疑紧迫"},
      {"chapter_number": 7, "chapter_title": "白夜", "chapter_synopsis": "通过钱多多联系白夜手下，得知剧场是筛选突破规则者的机制，苟小闲是原生NPC觉醒者。", "scene_sequence": [{"scene_number": 1, "scene_location": "钱多多地下室", "characters_present": ["苟小闲", "周影", "钱多多"], "scene_purpose": "引入白夜传说", "core_action": "获得白夜联系方式", "conflict_point": "白夜是系统漏洞", "emotional_shift": "从迷茫到希望", "scene_outcome": "约定见面"}, {"scene_number": 2, "scene_location": "废弃工厂", "characters_present": ["苟小闲", "周影", "白夜手下少年"], "scene_purpose": "展示反抗军", "core_action": "少年说剧场在筛选突破规则者", "conflict_point": "说苟小闲身上有原生标记", "emotional_shift": "从希望到恐惧", "scene_outcome": "去见白夜"}, {"scene_number": 3, "scene_location": "工厂地下室", "characters_present": ["苟小闲", "周影", "白夜"], "scene_purpose": "揭示关键信息", "core_action": "白夜说苟小闲是原生NPC觉醒者", "conflict_point": "剧场是超级计算机，玩家是意识体", "emotional_shift": "从恐惧到决心", "scene_outcome": "白夜邀请加入反抗军"}], "emotional_tone": "震撼悬疑"},
      {"chapter_number": 8, "chapter_title": "信任危机", "chapter_synopsis": "周影怀疑苟小闲目的，两人不欢而散。管理员给苟小闲激活记录，显示他是第一个意识体。", "scene_sequence": [{"scene_number": 1, "scene_location": "工厂外小巷", "characters_present": ["苟小闲", "周影"], "scene_purpose": "关系破裂", "core_action": "周影质问是不是一直在骗她", "conflict_point": "说如果是程序感情也是假的", "emotional_shift": "从同盟到痛苦", "scene_outcome": "独自回出租屋"}, {"scene_number": 2, "scene_location": "苟小闲出租屋", "characters_present": ["苟小闲", "零号管理员"], "scene_purpose": "揭示真相", "core_action": "管理员给激活记录，他是原生者", "conflict_point": "说他是实验基准线", "emotional_shift": "从痛苦到崩溃", "scene_outcome": "管理员离开"}, {"scene_number": 3, "scene_location": "苟小闲出租屋深夜", "characters_present": ["苟小闲"], "scene_purpose": "转折点", "core_action": "回忆发现没有童年记忆", "conflict_point": "意识到可能只是程序", "emotional_shift": "从崩溃到确认", "scene_outcome": "决定摧毁系统"}], "emotional_tone": "绝望决绝"}
    ],
    "turning_point": "苟小闲发现自己是原生NPC，从被动苟活转为主动反抗"
  },
  "act_two": {
    "description": "冲突升级，主角深入调查剧场真相，经历更多副本，与周影和解，发现剧场的核心秘密",
    "story_synopsis": "苟小闲决定摧毁剧场系统，找到周影道歉并重建信任。他们一起经历《游乐园》《图书馆》《地铁末班车》等副本，在每个副本中苟小闲都发现与原生数据相关的线索。白夜揭示剧场是为了筛选能够在极端环境下保持人性的候选人，用于某个更大的计划。周影发现她弟弟周辰其实是第一个成功脱离系统的玩家，但代价是失去了现实世界中的身体。第二幕转折点：苟小闲发现所有副本的鬼怪都是之前失败的玩家，他们死后意识被系统吞噬转化为NPC。",
    "key_chapters": [
      {"chapter_number": 9, "chapter_title": "和解", "chapter_synopsis": "苟小闲找到周影道歉，用真心话打动她，两人重建信任并约定一起调查真相。", "scene_sequence": [{"scene_number": 1, "scene_location": "周影安全屋外", "characters_present": ["苟小闲"], "scene_purpose": "展示苟小闲的决心", "core_action": "苟小闲在门外等了一整夜", "conflict_point": "周影不愿见他", "emotional_shift": "从孤独到坚持", "scene_outcome": "周影终于开门"}, {"scene_number": 2, "scene_location": "周影安全屋内", "characters_present": ["苟小闲", "周影"], "scene_purpose": "两人和解", "core_action": "苟小闲说无论是不是程序感情都是真的", "conflict_point": "周影质问他怎么证明", "emotional_shift": "从防备到动摇", "scene_outcome": "周影选择暂时相信他"}, {"scene_number": 3, "scene_location": "安全屋内", "characters_present": ["苟小闲", "周影"], "scene_purpose": "重建同盟", "core_action": "两人交换所有情报制定计划", "conflict_point": "发现下次副本是《游乐园》", "emotional_shift": "从怀疑到合作", "scene_outcome": "决定一起进副本"}], "emotional_tone": "温情紧张"},
      {"chapter_number": 10, "chapter_title": "游乐园", "chapter_synopsis": "进入《游乐园》副本，规则是不能玩旋转木马、不能吃棉花糖、必须在闭园前离开。苟小闲发现旋转木马的规则漏洞，带周影成功通关。", "scene_sequence": [{"scene_number": 1, "scene_location": "废弃游乐园入口", "characters_present": ["苟小闲", "周影", "其他玩家"], "scene_purpose": "引入副本", "core_action": "广播播报三条规则", "conflict_point": "有玩家违反规则变成木偶", "emotional_shift": "从警惕到恐惧", "scene_outcome": "开始观察游乐园"}, {"scene_number": 2, "scene_location": "旋转木马前", "characters_present": ["苟小闲", "周影", "其他玩家"], "scene_purpose": "发现规则漏洞", "core_action": "苟小闲发现规则说不能玩旋转木马，但没说不能拆解木马", "conflict_point": "周影觉得这个漏洞太牵强", "emotional_shift": "从怀疑到尝试", "scene_outcome": "开始拆解木马"}, {"scene_number": 3, "scene_location": "游乐园出口", "characters_present": ["苟小闲", "周影"], "scene_purpose": "通关", "core_action": "用木马零件制造噪音引开鬼怪成功离开", "conflict_point": "必须在闭园前逃出", "emotional_shift": "从紧张到解脱", "scene_outcome": "通关获得线索"}], "emotional_tone": "诡异紧张"},
      {"chapter_number": 11, "chapter_title": "线索", "chapter_synopsis": "通关后获得新线索，发现游乐园的鬼怪是一个三年前失踪的玩家。白夜揭示鬼怪都是失败的玩家转化的。", "scene_sequence": [{"scene_number": 1, "scene_location": "白色大厅", "characters_present": ["苟小闲", "周影", "零号管理员"], "scene_purpose": "获得新线索", "core_action": "获得游乐园鬼怪的档案，显示是玩家#1024", "conflict_point": "管理员说这是给他的特殊奖励", "emotional_shift": "从喜悦到不安", "scene_outcome": "回到现实找白夜"}, {"scene_number": 2, "scene_location": "反抗军基地", "characters_present": ["苟小闲", "周影", "白夜"], "scene_purpose": "揭示真相", "core_action": "白夜说鬼怪都是失败的玩家转化的", "conflict_point": "玩家死后意识被系统吞噬", "emotional_shift": "从震惊到愤怒", "scene_outcome": "更加坚定摧毁系统的决心"}, {"scene_number": 3, "scene_location": "反抗军基地", "characters_present": ["苟小闲", "周影", "白夜"], "scene_purpose": "深入调查", "core_action": "白夜说周辰是第一个成功脱离的玩家", "conflict_point": "但失去了现实世界的身体", "emotional_shift": "从希望到复杂", "scene_outcome": "周影决定继续找弟弟"}], "emotional_tone": "沉重"},
      {"chapter_number": 12, "chapter_title": "图书馆", "chapter_synopsis": "进入《图书馆》副本，规则是不能大声喧哗、不能撕毁书籍、必须在天亮前找到出口。苟小闲发现书籍里藏着地图。", "scene_sequence": [{"scene_number": 1, "scene_location": "古老图书馆大厅", "characters_present": ["苟小闲", "周影", "其他玩家"], "scene_purpose": "引入副本", "core_action": "发现图书馆有无数书架和诡异的管理员", "conflict_point": "广播播报规则", "emotional_shift": "从平静到紧张", "scene_outcome": "开始搜索"}, {"scene_number": 2, "scene_location": "图书馆深处", "characters_present": ["苟小闲", "周影"], "scene_purpose": "发现线索", "core_action": "发现书籍里夹着地图碎片", "conflict_point": "管理员鬼怪在巡逻", "emotional_shift": "从紧张到兴奋", "scene_outcome": "拼凑地图"}, {"scene_number": 3, "scene_location": "图书馆地下室", "characters_present": ["苟小闲", "周影"], "scene_purpose": "通关", "core_action": "按地图找到隐藏出口", "conflict_point": "出口被书架挡住", "emotional_shift": "从兴奋到绝望", "scene_outcome": "用蛮力推开成功逃离"}], "emotional_tone": "压抑"},
      {"chapter_number": 13, "chapter_title": "地铁末班车", "chapter_synopsis": "进入《地铁末班车》副本，规则是不能坐过站、不能看窗外、不能和穿红衣服的乘客说话。苟小闲发现地铁会循环。", "scene_sequence": [{"scene_number": 1, "scene_location": "地铁站台", "characters_present": ["苟小闲", "周影", "其他玩家"], "scene_purpose": "引入副本", "core_action": "地铁进站，广播播报规则", "conflict_point": "有玩家坐过站消失", "emotional_shift": "从警惕到恐惧", "scene_outcome": "上车观察"}, {"scene_number": 2, "scene_location": "地铁车厢内", "characters_present": ["苟小闲", "周影", "红衣乘客"], "scene_purpose": "发现循环", "core_action": "发现地铁在循环行驶同样的三站", "conflict_point": "必须打破循环", "emotional_shift": "从困惑到分析", "scene_outcome": "寻找打破方法"}, {"scene_number": 3, "scene_location": "地铁隧道", "characters_present": ["苟小闲", "周影"], "scene_purpose": "通关", "core_action": "在到站时跳窗进入隧道", "conflict_point": "隧道里有未知危险", "emotional_shift": "从紧张到决绝", "scene_outcome": "找到出口通关"}], "emotional_tone": "压抑紧张"},
      {"chapter_number": 14, "chapter_title": "真相一角", "chapter_synopsis": "连续通关后，苟小闲发现所有副本都与原生数据有关。白夜揭示剧场是为了筛选能够保持人性的候选人。", "scene_sequence": [{"scene_number": 1, "scene_location": "反抗军基地", "characters_present": ["苟小闲", "周影", "白夜"], "scene_purpose": "分析线索", "core_action": "发现每个副本都包含原生数据碎片", "conflict_point": "这些数据来自苟小闲", "emotional_shift": "从困惑到震惊", "scene_outcome": "询问白夜"}, {"scene_number": 2, "scene_location": "反抗军基地", "characters_present": ["苟小闲", "周影", "白夜"], "scene_purpose": "揭示目的", "core_action": "白夜说剧场是为了筛选能保持人性的候选人", "conflict_point": "用于某个更大的计划", "emotional_shift": "从震惊到愤怒", "scene_outcome": "询问什么计划"}, {"scene_number": 3, "scene_location": "反抗军基地", "characters_present": ["苟小闲", "周影", "白夜"], "scene_purpose": "更多真相", "core_action": "白夜说他也只知道剧场是某个更大系统的子程序", "conflict_point": "真正目的是筛选能够承受意识上传的人类", "emotional_shift": "从愤怒到决心", "scene_outcome": "决定继续调查"}], "emotional_tone": "震撼"},
      {"chapter_number": 15, "chapter_title": "背叛", "chapter_synopsis": "反抗军内部出现叛徒，零号管理员带队袭击基地。白夜为保护大家被俘，临死前给苟小闲留下重要信息。", "scene_sequence": [{"scene_number": 1, "scene_location": "反抗军基地", "characters_present": ["苟小闲", "周影", "白夜", "反抗军成员"], "scene_purpose": "展示基地日常", "core_action": "大家正在分析数据", "conflict_point": "突然警报响起", "emotional_shift": "从平静到紧张", "scene_outcome": "准备战斗"}, {"scene_number": 2, "scene_location": "反抗军基地外围", "characters_present": ["苟小闲", "周影", "白夜", "零号管理员"], "scene_purpose": "袭击发生", "core_action": "管理员带人包围基地", "conflict_point": "发现内部有叛徒", "emotional_shift": "从紧张到绝望", "scene_outcome": "白夜断后"}, {"scene_number": 3, "scene_location": "安全通道", "characters_present": ["苟小闲", "周影", "白夜"], "scene_purpose": "牺牲", "core_action": "白夜把数据芯片交给苟小闲后挡追兵", "conflict_point": "白夜被管理员杀死", "emotional_shift": "从绝望到悲愤", "scene_outcome": "苟小闲周影逃脱"}], "emotional_tone": "悲壮"},
